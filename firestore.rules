rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'lastSeen'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 200
        && request.resource.data.lastSeen == request.time;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
    match /calls/{id} {
      allow read: if request.auth != null && (resource.data.to == request.auth.uid || resource.data.from == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['from','to','room','createdAt'])
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to is string && request.resource.data.to != request.auth.uid
        && exists(/databases/$(database)/documents/users/$(request.resource.data.to))
        && request.resource.data.room is string
        && request.resource.data.room.matches('noi-[a-zA-Z0-9-]{36}')
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
  }
}
